/**
 * DocumentModel.js
 *
 * 连续语义编辑器的数据模型。
 *
 * 这个文件只负责：
 * 1. 管理语义模块的数据
 * 2. 插入、删除、移动模块
 * 3. 更新模块文本和属性
 * 4. 拆分、合并、替换模块
 * 5. 在 sections 和 DocumentModel 之间转换
 *
 * 不负责：
 * 1. React 渲染
 * 2. contentEditable
 * 3. 光标和选区
 * 4. DOM 操作
 */

export const DEFAULT_BLOCK_TYPE =
  "Generated";

export const DEFAULT_PLACEMENT =
  "inline";

/**
 * 创建前端临时 ID。
 */
export function createDocumentBlockId() {
  if (
    typeof crypto !== "undefined" &&
    typeof crypto.randomUUID ===
      "function"
  ) {
    return crypto.randomUUID();
  }

  return `block-${Date.now()}-${Math.random()
    .toString(36)
    .slice(2, 10)}`;
}

function normalizeId(id) {
  if (
    id === null ||
    id === undefined ||
    id === ""
  ) {
    return createDocumentBlockId();
  }

  return String(id);
}

function normalizeText(text) {
  if (
    text === null ||
    text === undefined
  ) {
    return "";
  }

  return String(text);
}

function clampIndex(
  index,
  minimum,
  maximum
) {
  const numericIndex = Number(index);

  if (
    !Number.isFinite(numericIndex)
  ) {
    return minimum;
  }

  return Math.min(
    maximum,
    Math.max(
      minimum,
      Math.trunc(numericIndex)
    )
  );
}

function shallowEqualBlock(
  firstBlock,
  secondBlock
) {
  if (
    firstBlock === secondBlock
  ) {
    return true;
  }

  if (
    !firstBlock ||
    !secondBlock
  ) {
    return false;
  }

  const firstKeys =
    Object.keys(firstBlock);

  const secondKeys =
    Object.keys(secondBlock);

  if (
    firstKeys.length !==
    secondKeys.length
  ) {
    return false;
  }

  return firstKeys.every(
    (key) =>
      firstBlock[key] ===
      secondBlock[key]
  );
}

/**
 * 标准化一个模块。
 *
 * inline 模块不再使用旧画布布局数据：
 * x、y、width、height 等属性会被清除。
 */
export function normalizeDocumentBlock(
  block = {},
  options = {}
) {
  const {
    forceId,
  } = options;

  const placement =
    block.placement ||
    DEFAULT_PLACEMENT;

  const normalizedBlock = {
    ...block,

    id: normalizeId(
      forceId ??
        block.id
    ),

    type:
      block.type ||
      DEFAULT_BLOCK_TYPE,

    text: normalizeText(
      block.text
    ),

    placement,
  };

  if (
    placement !== "floating"
  ) {
    delete normalizedBlock.x;
    delete normalizedBlock.y;
    delete normalizedBlock.width;
    delete normalizedBlock.height;

    delete normalizedBlock.floatingX;
    delete normalizedBlock.floatingY;
    delete normalizedBlock.floatingWidth;
    delete normalizedBlock.floatingHeight;
  }

  return normalizedBlock;
}

/**
 * 标准化模块数组，并保证 ID 唯一。
 */
export function normalizeDocumentBlocks(
  blocks
) {
  if (!Array.isArray(blocks)) {
    return [];
  }

  const usedIds =
    new Set();

  return blocks.map(
    (block) => {
      let normalizedBlock =
        normalizeDocumentBlock(
          block
        );

      while (
        usedIds.has(
          normalizedBlock.id
        )
      ) {
        normalizedBlock = {
          ...normalizedBlock,
          id: createDocumentBlockId(),
        };
      }

      usedIds.add(
        normalizedBlock.id
      );

      return normalizedBlock;
    }
  );
}

/**
 * 根据文档顺序排列模块 ID。
 */
export function sortBlockIdsByDocumentOrder(
  blockIds,
  documentModel
) {
  const model =
    DocumentModel.from(
      documentModel
    );

  const uniqueIds = [
    ...new Set(
      (blockIds || []).map(
        (id) => String(id)
      )
    ),
  ];

  return uniqueIds
    .filter((id) =>
      model.hasBlock(id)
    )
    .sort(
      (firstId, secondId) =>
        model.getIndex(firstId) -
        model.getIndex(secondId)
    );
}

export class DocumentModel {
  constructor(blocks = []) {
    this.blocks =
      normalizeDocumentBlocks(
        blocks
      );

    this.indexById =
      new Map();

    this.blocks.forEach(
      (block, index) => {
        this.indexById.set(
          block.id,
          index
        );
      }
    );
  }

  static empty() {
    return new DocumentModel(
      []
    );
  }

  static from(value) {
    if (
      value instanceof
      DocumentModel
    ) {
      return value;
    }

    if (Array.isArray(value)) {
      return new DocumentModel(
        value
      );
    }

    if (
      value &&
      Array.isArray(value.blocks)
    ) {
      return new DocumentModel(
        value.blocks
      );
    }

    return DocumentModel.empty();
  }

  get size() {
    return this.blocks.length;
  }

  get length() {
    return this.blocks.length;
  }

  isEmpty() {
    return (
      this.blocks.length === 0
    );
  }

  toArray() {
    return this.blocks.map(
      (block) => ({
        ...block,
      })
    );
  }

  toJSON() {
    return {
      blocks: this.toArray(),
    };
  }

  hasBlock(blockId) {
    return this.indexById.has(
      String(blockId)
    );
  }

  getIndex(blockId) {
    const index =
      this.indexById.get(
        String(blockId)
      );

    return index ??
      -1;
  }

  getBlock(blockId) {
    const index =
      this.getIndex(blockId);

    if (index < 0) {
      return null;
    }

    return this.blocks[index];
  }

  getBlockAt(index) {
    if (
      index < 0 ||
      index >=
        this.blocks.length
    ) {
      return null;
    }

    return this.blocks[index];
  }

  getFirstBlock() {
    return (
      this.blocks[0] ||
      null
    );
  }

  getLastBlock() {
    return (
      this.blocks[
        this.blocks.length - 1
      ] || null
    );
  }

  getPreviousBlock(
    blockId
  ) {
    const index =
      this.getIndex(blockId);

    if (index <= 0) {
      return null;
    }

    return (
      this.blocks[index - 1] ||
      null
    );
  }

  getNextBlock(blockId) {
    const index =
      this.getIndex(blockId);

    if (
      index < 0 ||
      index >=
        this.blocks.length - 1
    ) {
      return null;
    }

    return (
      this.blocks[index + 1] ||
      null
    );
  }

  /**
   * 在指定位置插入模块。
   */
  insertBlock(
    block,
    index = this.blocks.length
  ) {
    const nextBlocks =
      this.toArray();

    let normalizedBlock =
      normalizeDocumentBlock(
        block
      );

    while (
      this.hasBlock(
        normalizedBlock.id
      )
    ) {
      normalizedBlock = {
        ...normalizedBlock,
        id: createDocumentBlockId(),
      };
    }

    const targetIndex =
      clampIndex(
        index,
        0,
        nextBlocks.length
      );

    nextBlocks.splice(
      targetIndex,
      0,
      normalizedBlock
    );

    return new DocumentModel(
      nextBlocks
    );
  }

  insertBefore(
    targetBlockId,
    block
  ) {
    const targetIndex =
      this.getIndex(
        targetBlockId
      );

    if (targetIndex < 0) {
      return this;
    }

    return this.insertBlock(
      block,
      targetIndex
    );
  }

  insertAfter(
    targetBlockId,
    block
  ) {
    const targetIndex =
      this.getIndex(
        targetBlockId
      );

    if (targetIndex < 0) {
      return this;
    }

    return this.insertBlock(
      block,
      targetIndex + 1
    );
  }

  /**
   * 删除一个模块。
   */
  deleteBlock(blockId) {
    const targetId =
      String(blockId);

    if (
      !this.hasBlock(targetId)
    ) {
      return this;
    }

    return new DocumentModel(
      this.blocks.filter(
        (block) =>
          block.id !==
          targetId
      )
    );
  }

  /**
   * 删除多个模块。
   */
  deleteBlocks(blockIds) {
    const targetIds =
      new Set(
        (blockIds || []).map(
          (id) => String(id)
        )
      );

    if (
      targetIds.size === 0
    ) {
      return this;
    }

    const nextBlocks =
      this.blocks.filter(
        (block) =>
          !targetIds.has(
            block.id
          )
      );

    if (
      nextBlocks.length ===
      this.blocks.length
    ) {
      return this;
    }

    return new DocumentModel(
      nextBlocks
    );
  }

  /**
   * 更新一个模块的任意属性。
   */
  updateBlock(
    blockId,
    updates
  ) {
    const targetIndex =
      this.getIndex(
        blockId
      );

    if (targetIndex < 0) {
      return this;
    }

    const currentBlock =
      this.blocks[
        targetIndex
      ];

    const resolvedUpdates =
      typeof updates ===
      "function"
        ? updates(
            currentBlock
          )
        : updates;

    if (
      !resolvedUpdates ||
      typeof resolvedUpdates !==
        "object"
    ) {
      return this;
    }

    const nextBlock =
      normalizeDocumentBlock(
        {
          ...currentBlock,
          ...resolvedUpdates,
        },
        {
          forceId:
            currentBlock.id,
        }
      );

    if (
      shallowEqualBlock(
        currentBlock,
        nextBlock
      )
    ) {
      return this;
    }

    const nextBlocks =
      this.toArray();

    nextBlocks[
      targetIndex
    ] = nextBlock;

    return new DocumentModel(
      nextBlocks
    );
  }

  /**
   * 单独更新模块文本。
   */
  updateBlockText(
    blockId,
    text
  ) {
    return this.updateBlock(
      blockId,
      {
        text: normalizeText(
          text
        ),
      }
    );
  }

  /**
   * 批量更新模块文本。
   *
   * 支持：
   * {
   *   blockId1: "新文本",
   *   blockId2: "新文本"
   * }
   *
   * 或：
   * [
   *   { id: "blockId1", text: "新文本" }
   * ]
   */
  updateBlockTexts(
    updates
  ) {
    const textById =
      new Map();

    if (
      Array.isArray(updates)
    ) {
      updates.forEach(
        (item) => {
          if (
            item?.id ===
              undefined ||
            item?.id === null
          ) {
            return;
          }

          textById.set(
            String(item.id),
            normalizeText(
              item.text
            )
          );
        }
      );
    } else if (
      updates &&
      typeof updates ===
        "object"
    ) {
      Object.entries(
        updates
      ).forEach(
        ([id, text]) => {
          textById.set(
            String(id),
            normalizeText(
              text
            )
          );
        }
      );
    }

    if (
      textById.size === 0
    ) {
      return this;
    }

    let hasChanges =
      false;

    const nextBlocks =
      this.blocks.map(
        (block) => {
          if (
            !textById.has(
              block.id
            )
          ) {
            return block;
          }

          const nextText =
            textById.get(
              block.id
            );

          if (
            nextText ===
            block.text
          ) {
            return block;
          }

          hasChanges = true;

          return {
            ...block,
            text: nextText,
          };
        }
      );

    if (!hasChanges) {
      return this;
    }

    return new DocumentModel(
      nextBlocks
    );
  }

  /**
   * 更新模块的语义类型和视觉属性。
   */
  updateBlockType(
    blockId,
    type,
    appearance = {}
  ) {
    return this.updateBlock(
      blockId,
      {
        type:
          type ||
          DEFAULT_BLOCK_TYPE,

        ...appearance,
      }
    );
  }

  updateBlockAppearance(
    blockId,
    appearance = {}
  ) {
    const {
      label,
      color,
      fill,
    } = appearance;

    return this.updateBlock(
      blockId,
      {
        ...(label !==
        undefined
          ? { label }
          : {}),

        ...(color !==
        undefined
          ? { color }
          : {}),

        ...(fill !==
        undefined
          ? { fill }
          : {}),
      }
    );
  }

  /**
   * 完整替换一个模块，但保留原来的 ID。
   */
  replaceBlock(
    blockId,
    nextBlock
  ) {
    const targetIndex =
      this.getIndex(
        blockId
      );

    if (targetIndex < 0) {
      return this;
    }

    const currentBlock =
      this.blocks[
        targetIndex
      ];

    const normalizedBlock =
      normalizeDocumentBlock(
        {
          ...currentBlock,
          ...nextBlock,
        },
        {
          forceId:
            currentBlock.id,
        }
      );

    const nextBlocks =
      this.toArray();

    nextBlocks[
      targetIndex
    ] = normalizedBlock;

    return new DocumentModel(
      nextBlocks
    );
  }

  /**
   * 移动一个模块。
   *
   * targetIndex 表示移动完成后，
   * 模块所在的最终索引。
   */
  moveBlock(
    blockId,
    targetIndex
  ) {
    const sourceIndex =
      this.getIndex(
        blockId
      );

    if (sourceIndex < 0) {
      return this;
    }

    const nextBlocks =
      this.toArray();

    const [movingBlock] =
      nextBlocks.splice(
        sourceIndex,
        1
      );

    const finalIndex =
      clampIndex(
        targetIndex,
        0,
        nextBlocks.length
      );

    nextBlocks.splice(
      finalIndex,
      0,
      movingBlock
    );

    if (
      finalIndex ===
      sourceIndex
    ) {
      return this;
    }

    return new DocumentModel(
      nextBlocks
    );
  }

  moveBefore(
    blockId,
    targetBlockId
  ) {
    const sourceIndex =
      this.getIndex(blockId);

    const targetIndex =
      this.getIndex(
        targetBlockId
      );

    if (
      sourceIndex < 0 ||
      targetIndex < 0 ||
      sourceIndex ===
        targetIndex
    ) {
      return this;
    }

    let finalIndex =
      targetIndex;

    if (
      sourceIndex <
      targetIndex
    ) {
      finalIndex -= 1;
    }

    return this.moveBlock(
      blockId,
      finalIndex
    );
  }

  moveAfter(
    blockId,
    targetBlockId
  ) {
    const sourceIndex =
      this.getIndex(blockId);

    const targetIndex =
      this.getIndex(
        targetBlockId
      );

    if (
      sourceIndex < 0 ||
      targetIndex < 0 ||
      sourceIndex ===
        targetIndex
    ) {
      return this;
    }

    let finalIndex =
      targetIndex + 1;

    if (
      sourceIndex <
      targetIndex
    ) {
      finalIndex -= 1;
    }

    return this.moveBlock(
      blockId,
      finalIndex
    );
  }

  /**
   * 按照指定 ID 顺序重新排列选中的模块。
   *
   * 未选中的模块保持原来的位置。
   */
  reorderSelectedBlocks(
    orderedBlockIds
  ) {
    const sortedIds =
      sortBlockIdsByDocumentOrder(
        orderedBlockIds,
        this
      );

    if (
      sortedIds.length < 2
    ) {
      return this;
    }

    const requestedOrder = [
      ...new Set(
        orderedBlockIds.map(
          (id) => String(id)
        )
      ),
    ].filter((id) =>
      this.hasBlock(id)
    );

    if (
      requestedOrder.length !==
      sortedIds.length
    ) {
      return this;
    }

    const blockById =
      new Map(
        requestedOrder.map(
          (id) => [
            id,
            this.getBlock(id),
          ]
        )
      );

    let replacementIndex =
      0;

    const selectedIdSet =
      new Set(sortedIds);

    const nextBlocks =
      this.blocks.map(
        (block) => {
          if (
            !selectedIdSet.has(
              block.id
            )
          ) {
            return block;
          }

          const nextId =
            requestedOrder[
              replacementIndex
            ];

          replacementIndex +=
            1;

          return blockById.get(
            nextId
          );
        }
      );

    return new DocumentModel(
      nextBlocks
    );
  }

  /**
   * 将一个模块从指定字符位置拆成两个模块。
   */
  splitBlock(
    blockId,
    offset,
    options = {}
  ) {
    const targetIndex =
      this.getIndex(
        blockId
      );

    if (targetIndex < 0) {
      return this;
    }

    const {
      trimStart = false,
      trimEnd = false,
      nextBlockId,
      nextType,
    } = options;

    const currentBlock =
      this.blocks[
        targetIndex
      ];

    const text =
      normalizeText(
        currentBlock.text
      );

    const splitOffset =
      clampIndex(
        offset,
        0,
        text.length
      );

    let firstText =
      text.slice(
        0,
        splitOffset
      );

    let secondText =
      text.slice(
        splitOffset
      );

    if (trimEnd) {
      firstText =
        firstText.trimEnd();
    }

    if (trimStart) {
      secondText =
        secondText.trimStart();
    }

    const firstBlock =
      normalizeDocumentBlock(
        {
          ...currentBlock,
          text: firstText,
        },
        {
          forceId:
            currentBlock.id,
        }
      );

    const secondBlock =
      normalizeDocumentBlock({
        ...currentBlock,

        id:
          nextBlockId ||
          createDocumentBlockId(),

        type:
          nextType ||
          currentBlock.type,

        text: secondText,
      });

    const nextBlocks =
      this.toArray();

    nextBlocks.splice(
      targetIndex,
      1,
      firstBlock,
      secondBlock
    );

    return new DocumentModel(
      nextBlocks
    );
  }

  /**
   * 合并两个相邻模块。
   *
   * 合并后保留第一个模块，
   * 第二个模块会被删除。
   */
  mergeBlocks(
    firstBlockId,
    secondBlockId,
    options = {}
  ) {
    const firstIndex =
      this.getIndex(
        firstBlockId
      );

    const secondIndex =
      this.getIndex(
        secondBlockId
      );

    if (
      firstIndex < 0 ||
      secondIndex < 0
    ) {
      return this;
    }

    if (
      secondIndex !==
      firstIndex + 1
    ) {
      return this;
    }

    const firstBlock =
      this.blocks[
        firstIndex
      ];

    const secondBlock =
      this.blocks[
        secondIndex
      ];

    const {
      separator = " ",
      type =
        firstBlock.type,
      label =
        firstBlock.label,
      color =
        firstBlock.color,
      fill =
        firstBlock.fill,
      text,
    } = options;

    const mergedText =
      text !== undefined
        ? normalizeText(text)
        : `${normalizeText(
            firstBlock.text
          )}${separator}${normalizeText(
            secondBlock.text
          )}`;

    const mergedBlock =
      normalizeDocumentBlock(
        {
          ...firstBlock,
          type,
          label,
          color,
          fill,
          text: mergedText,
        },
        {
          forceId:
            firstBlock.id,
        }
      );

    const nextBlocks =
      this.toArray();

    nextBlocks.splice(
      firstIndex,
      2,
      mergedBlock
    );

    return new DocumentModel(
      nextBlocks
    );
  }

  /**
   * 用一组新模块替换指定范围。
   *
   * 可用于：
   * 1. AI 融合
   * 2. AI 拼接
   * 3. 多模块重写
   * 4. 插入过渡句
   */
  replaceRange(
    startIndex,
    deleteCount,
    replacementBlocks = []
  ) {
    const safeStartIndex =
      clampIndex(
        startIndex,
        0,
        this.blocks.length
      );

    const safeDeleteCount =
      clampIndex(
        deleteCount,
        0,
        this.blocks.length -
          safeStartIndex
      );

    const existingIds =
      new Set(
        this.blocks
          .filter(
            (_, index) =>
              index <
                safeStartIndex ||
              index >=
                safeStartIndex +
                  safeDeleteCount
          )
          .map(
            (block) =>
              block.id
          )
      );

    const normalizedReplacements =
      normalizeDocumentBlocks(
        replacementBlocks
      ).map((block) => {
        let nextBlock =
          block;

        while (
          existingIds.has(
            nextBlock.id
          )
        ) {
          nextBlock = {
            ...nextBlock,
            id: createDocumentBlockId(),
          };
        }

        existingIds.add(
          nextBlock.id
        );

        return nextBlock;
      });

    const nextBlocks =
      this.toArray();

    nextBlocks.splice(
      safeStartIndex,
      safeDeleteCount,
      ...normalizedReplacements
    );

    return new DocumentModel(
      nextBlocks
    );
  }

  /**
   * 获取两个模块之间的连续范围。
   */
  getRange(
    startBlockId,
    endBlockId
  ) {
    const startIndex =
      this.getIndex(
        startBlockId
      );

    const endIndex =
      this.getIndex(
        endBlockId
      );

    if (
      startIndex < 0 ||
      endIndex < 0
    ) {
      return [];
    }

    const rangeStart =
      Math.min(
        startIndex,
        endIndex
      );

    const rangeEnd =
      Math.max(
        startIndex,
        endIndex
      );

    return this.blocks.slice(
      rangeStart,
      rangeEnd + 1
    );
  }

  /**
   * 根据文档顺序返回选中的模块。
   */
  getBlocksInDocumentOrder(
    blockIds
  ) {
    const targetIds =
      new Set(
        (blockIds || []).map(
          (id) => String(id)
        )
      );

    return this.blocks.filter(
      (block) =>
        targetIds.has(
          block.id
        )
    );
  }
}

/**
 * 从旧的 sections 数据中提取 inline 模块。
 *
 * completed section 不进入当前编辑文档。
 * floating 模块也不进入 inline 文档流。
 */
export function createDocumentModelFromSections(
  sections
) {
  if (
    !Array.isArray(sections)
  ) {
    return DocumentModel.empty();
  }

  const blocks = [];

  sections.forEach(
    (section) => {
      if (
        section?.mode !==
        "editing"
      ) {
        return;
      }

      (
        section.blocks ||
        []
      ).forEach(
        (block) => {
          if (
            block?.placement ===
            "floating"
          ) {
            return;
          }

          blocks.push(block);
        }
      );
    }
  );

  return new DocumentModel(
    blocks
  );
}

/**
 * 删除文档流模块，同时保留真实段落边界。
 *
 * forceLineBreakBefore 存在于每段第一个模块上。如果该模块被删除，
 * 必须把标记转交给后面的第一个未删除模块，否则这一段会并入上一段。
 * 这是所有删除入口共同使用的数据规则。
 */
export function deleteDocumentBlocksPreservingParagraphStarts(
  documentModel,
  blockIds
) {
  const model = DocumentModel.from(documentModel);
  const deletedIds = new Set(
    (blockIds || []).map((id) => String(id))
  );

  if (deletedIds.size === 0) {
    return model;
  }

  const originalBlocks = model.toArray();
  const paragraphStartSuccessors = new Set();

  originalBlocks.forEach((block, index) => {
    const blockId = String(block.id);
    if (
      !deletedIds.has(blockId) ||
      !block.forceLineBreakBefore
    ) {
      return;
    }

    for (
      let nextIndex = index + 1;
      nextIndex < originalBlocks.length;
      nextIndex += 1
    ) {
      const nextBlock = originalBlocks[nextIndex];
      const nextId = String(nextBlock.id);
      if (deletedIds.has(nextId)) {
        continue;
      }

      paragraphStartSuccessors.add(nextId);
      break;
    }
  });

  let nextModel = model.deleteBlocks([...deletedIds]);

  paragraphStartSuccessors.forEach((blockId) => {
    if (!nextModel.hasBlock(blockId)) {
      return;
    }

    nextModel = nextModel.updateBlock(blockId, {
      forceLineBreakBefore: true,
    });
  });

  return nextModel;
}

/**
 * 将 DocumentModel 写回旧的 sections 数据结构。
 *
 * 保留：
 * 1. completed sections
 * 2. floating blocks
 *
 * 重建：
 * 1. 当前 editing section 中的 inline blocks
 */
export function applyDocumentModelToSections(
  sections,
  documentModel,
  createEditingSection
) {
  const safeSections =
    Array.isArray(sections)
      ? sections
      : [];

  const model =
    DocumentModel.from(
      documentModel
    );

  const completedSections =
    safeSections.filter(
      (section) =>
        section?.mode ===
        "completed"
    );

  const existingEditingSection =
    safeSections.find(
      (section) =>
        section?.mode ===
        "editing"
    );

  const floatingBlocks =
    safeSections.flatMap(
      (section) =>
        (
          section?.blocks ||
          []
        ).filter(
          (block) =>
            block?.placement ===
            "floating"
        )
    );

  let editingSection;

  if (
    typeof createEditingSection ===
    "function"
  ) {
    editingSection =
      createEditingSection(
        model.toArray()
      );
  } else {
    editingSection = {
      ...(existingEditingSection ||
        {}),

      id:
        existingEditingSection
          ?.id ||
        `editing-${Date.now()}`,

      mode: "editing",

      blocks: [],
    };
  }

  editingSection = {
    ...editingSection,

    mode: "editing",

    blocks: [
      ...model.toArray(),
      ...floatingBlocks.map(
        (block) =>
          normalizeDocumentBlock({
            ...block,
            placement:
              "floating",
          })
      ),
    ],
  };

  return [
    ...completedSections,
    editingSection,
  ];
}

export default DocumentModel;
